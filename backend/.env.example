# ============================================================
# Andiny Atlas Environment Configuration Template
# ============================================================
# Copy this file to .env and replace placeholder values with
# environment-specific configuration.
#
# DO NOT commit real secrets to source control.
# ============================================================


# ------------------------------------------------------------
# Application
# ------------------------------------------------------------

APP_NAME=Andiny Atlas
APP_VERSION=0.19.0


# ------------------------------------------------------------
# Deployment Environment
# ------------------------------------------------------------
# Allowed ENVIRONMENT values:
# development
# testing
# staging
# production

ENVIRONMENT=development


# ------------------------------------------------------------
# Andiny Atlas Runtime Environment
# ------------------------------------------------------------
# Allowed ATLAS_ENV values:
# development
# demo
# test

ATLAS_ENV=development


# ------------------------------------------------------------
# Logging
# ------------------------------------------------------------

LOG_LEVEL=INFO


# ------------------------------------------------------------
# Database
# ------------------------------------------------------------

DATABASE_PATH=data/investigations.json


# ------------------------------------------------------------
# JWT Authentication
# ------------------------------------------------------------
# Use a secure secret in real environments.
# Production requires at least 32 characters.

JWT_SECRET_KEY=replace-with-a-secure-secret

JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30

JWT_ISSUER=AndinyAtlas


# ------------------------------------------------------------
# Development Seed Configuration
# ------------------------------------------------------------
# Must be false in production.

ALLOW_DEVELOPMENT_SEED=false


# ------------------------------------------------------------
# Development Seed Users
# ------------------------------------------------------------
# Configure these only when development seed functionality
# is intentionally enabled.

SEED_SUPER_ADMIN_NAME=Development Super Administrator
SEED_SUPER_ADMIN_EMAIL=superadmin@andiny.local
SEED_SUPER_ADMIN_PASSWORD=

SEED_ADMIN_NAME=Development Administrator
SEED_ADMIN_EMAIL=admin@andiny.local
SEED_ADMIN_PASSWORD=

SEED_SUPERVISOR_NAME=Development Supervisor
SEED_SUPERVISOR_EMAIL=supervisor@andiny.local
SEED_SUPERVISOR_PASSWORD=

SEED_AGENT_NAME=Development Agent
SEED_AGENT_EMAIL=agent@andiny.local
SEED_AGENT_PASSWORD=
