[32m+[m[32m    │[m
[32m+[m[32m    ▼[m
[32m+[m[32mJWT Validation[m
[32m+[m[32m    │[m
[32m+[m[32m    ▼[m
[32m+[m[32mCurrent User Resolution[m
[32m+[m[32m    │[m
[32m+[m[32m    ▼[m
[32m+[m[32mOverride created_by[m
[32m+[m[32m    │[m
[32m+[m[32m    ▼[m
[32m+[m[32mExecute Query[m
[32m+[m[32m    │[m
[32m+[m[32m    ▼[m
[32m+[m[32mReturn Authenticated User's Cases[m
[32m+[m[32m```[m
